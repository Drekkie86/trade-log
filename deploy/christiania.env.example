# Copy to /etc/christiania/christiania.env and restrict permissions.
# Never commit real secrets.

CHRISTIANIA_DB_PATH=/var/lib/christiania/data/trade_log.db
CHRISTIANIA_BACKUP_DIR=/var/lib/christiania/backups
# Maximum desired normal recovery-point count. If disk headroom cannot sustain
# that many full copies, Christiania may prune the oldest normal backups below
# this target before a new verified copy, but never pre-deletes the newest
# known-good normal recovery point.
CHRISTIANIA_BACKUP_RETENTION=14
# Daily timer evaluates policy; a full copy is created only when due.
# New completed research, schema drift, no recovery point, or this hard age triggers a backup.
CHRISTIANIA_BACKUP_MAX_AGE_HOURS=168
# One normal 09:45-15:45 ET sample window contains 25 scheduled iterations.
# Fewer new completed iterations remain protected by the existing recovery point
# until this threshold or the hard-age fallback is reached.
CHRISTIANIA_BACKUP_MIN_NEW_RESEARCH_ITERATIONS=25
CHRISTIANIA_AUDIT_DIR=/var/lib/christiania/audit

# Storage V2 research evidence archive.
# The hot database keeps the newest 50 completed runs. Older whole terminal
# sessions can be extracted into verified compressed cold archives.
# Archiving does NOT delete hot evidence; pruning remains blocked until an
# off-host immutable copy is independently confirmed.
CHRISTIANIA_EVIDENCE_ARCHIVE_DIR=/var/lib/christiania/evidence-archives
CHRISTIANIA_EVIDENCE_KEEP_HOT_COMPLETED_RUNS=50
CHRISTIANIA_EVIDENCE_ARCHIVE_MIN_FREE_BYTES=16106127360

# Storage V2B off-host immutable research evidence.
# Production target: an S3-compatible bucket created WITH Object Lock enabled.
# Christiania uploads archive + manifest with COMPLIANCE retention, restores
# the object back from remote storage, re-verifies both hashes, then records a
# separate local remote-proof file. Secrets belong only in the deployed env.
CHRISTIANIA_EVIDENCE_REMOTE_ENDPOINT=
CHRISTIANIA_EVIDENCE_REMOTE_REGION=
CHRISTIANIA_EVIDENCE_REMOTE_BUCKET=
CHRISTIANIA_EVIDENCE_REMOTE_ACCESS_KEY_ID=
CHRISTIANIA_EVIDENCE_REMOTE_SECRET_ACCESS_KEY=
CHRISTIANIA_EVIDENCE_REMOTE_PREFIX=christiania/research-evidence/v1
CHRISTIANIA_EVIDENCE_REMOTE_RETENTION_DAYS=365
CHRISTIANIA_THETA_JAR=/opt/christiania/vendor/ThetaTerminalv3.jar

# Secret: preferred unattended Theta authentication.
THETADATA_API_KEY=

# Research universe for the daemon service. Configure exactly one source.
# The governed profile contains 48 liquid US underlyings and rotates a bounded
# 12-symbol batch every 15-minute slot; the full profile is covered hourly.
CHRISTIANIA_UNIVERSE_PROFILE=LIQUID_US_RESEARCH_V1
CHRISTIANIA_UNIVERSE_BATCH_SIZE=12
# Alternative explicit universe:
# CHRISTIANIA_SYMBOLS=AAPL,MSFT,NVDA

# Secret: populate only in the deployed environment file.
MASSIVE_API_KEY=
CHRISTIANIA_THETA_BASE_URL=http://127.0.0.1:25503/v3
CHRISTIANIA_BURN_IN_LOG=/var/lib/christiania/audit/v1_burn_in.jsonl
CHRISTIANIA_BOOT_MARKER_PATH=/var/lib/christiania/audit/v1_boot_marker.json

# Baseline unattended reliability.
CHRISTIANIA_THETA_WATCHDOG_FAILURE_THRESHOLD=2

# External observability. Configure real endpoints in production, then set
# CHRISTIANIA_REQUIRE_EXTERNAL_OBSERVABILITY=1 so missing configuration is blocking.
CHRISTIANIA_ALERT_WEBHOOK_URL=
CHRISTIANIA_HEARTBEAT_URL=
CHRISTIANIA_HEARTBEAT_FAILURE_URL=
CHRISTIANIA_REQUIRE_EXTERNAL_OBSERVABILITY=0
CHRISTIANIA_ALERT_TIMEOUT_SECONDS=5

# V1 operational-independence gate.
# The example remains non-production by default. Before V1 activation:
#   1. configure all three external observability URLs above,
#   2. set CHRISTIANIA_REQUIRE_EXTERNAL_OBSERVABILITY=1,
#   3. run deploy/activate_operational_independence.sh.
CHRISTIANIA_V1_SUPERVISOR_MAX_AGE_MINUTES=12
# V1 activation command: deploy/activate_operational_independence.sh
