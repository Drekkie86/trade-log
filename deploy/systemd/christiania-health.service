[Unit]
Description=Christiania Strict Runtime Health Check
After=christiania-daemon.service

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/christiania_health.py --strict-daemon --strict-theta --json
NoNewPrivileges=true
PrivateTmp=true
