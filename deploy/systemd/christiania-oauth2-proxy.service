[Unit]
Description=Christiania OIDC Authentication Gateway
StartLimitIntervalSec=300
StartLimitBurst=5
After=network-online.target christiania-app.service
Wants=network-online.target
Requires=christiania-app.service

[Service]
Type=simple
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
Environment=HOME=/tmp
EnvironmentFile=/etc/christiania/secure-edge.env
Environment=OAUTH2_PROXY_PROVIDER=oidc
Environment=OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
Environment=OAUTH2_PROXY_UPSTREAMS=http://127.0.0.1:8501/
Environment=OAUTH2_PROXY_REVERSE_PROXY=true
Environment=OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
Environment=OAUTH2_PROXY_COOKIE_SECURE=true
Environment=OAUTH2_PROXY_COOKIE_HTTPONLY=true
Environment=OAUTH2_PROXY_COOKIE_SAMESITE=lax
Environment=OAUTH2_PROXY_COOKIE_NAME=__Host-christiania
Environment=OAUTH2_PROXY_COOKIE_PATH=/
Environment=OAUTH2_PROXY_SCOPE=openid email profile
Environment=OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
Environment=OAUTH2_PROXY_PROXY_WEBSOCKETS=true
Environment=OAUTH2_PROXY_SESSION_STORE_TYPE=cookie
Environment=OAUTH2_PROXY_COOKIE_EXPIRE=8h
Environment=OAUTH2_PROXY_COOKIE_REFRESH=1h
Environment=OAUTH2_PROXY_AUTH_LOGGING=true
Environment=OAUTH2_PROXY_REQUEST_LOGGING=true
Environment=OAUTH2_PROXY_STANDARD_LOGGING=true
ExecStart=/usr/local/libexec/christiania/oauth2-proxy
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
