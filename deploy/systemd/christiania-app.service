[Unit]
Description=Christiania Command Deck
StartLimitIntervalSec=300
StartLimitBurst=5
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=christiania-ui
Group=christiania-runtime
WorkingDirectory=/opt/christiania
Environment=HOME=/tmp
EnvironmentFile=/etc/christiania-ui/christiania.env
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/run_christiania_app.py --host 127.0.0.1 --port 8501
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/var/lib/christiania
InaccessiblePaths=/etc/christiania
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target