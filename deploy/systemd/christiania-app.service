[Unit]
Description=Christiania Command Deck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/run_christiania_app.py --host 127.0.0.1 --port 8501
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
