[Unit]
Description=Christiania Saxo LIVE OAuth Token Maintenance (No Order Access)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
Environment=CHRISTIANIA_DISABLE_LOCAL_ENV_FALLBACK=1
Environment=CHRISTIANIA_SAXO_TOKEN_STORE=/var/lib/christiania/secure/saxo-live.env
ExecStart=/opt/christiania/.venv/bin/python -m src.operations.saxo_session_keeper_v1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/var/lib/christiania/secure
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
