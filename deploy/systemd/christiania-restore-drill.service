[Unit]
Description=Christiania Verified Backup Restore Drill
After=christiania-backup.service

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/christiania_ops.py restore-drill
NoNewPrivileges=true
PrivateTmp=true
