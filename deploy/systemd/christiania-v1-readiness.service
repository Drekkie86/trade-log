[Unit]
Description=Christiania V1 Operational Independence Gate
After=network-online.target christiania-supervisor.service
Wants=network-online.target

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
Environment=HOME=/tmp
EnvironmentFile=/etc/christiania/christiania.env
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/christiania_v1_operational_readiness.py --json
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/christiania/audit
