[Unit]
Description=Christiania Verified SQLite Backup
After=network-online.target

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/backup_christiania.py
ExecStopPost=/opt/christiania/.venv/bin/python /opt/christiania/backup_christiania.py --cleanup-stale-temp
NoNewPrivileges=true
PrivateTmp=true
