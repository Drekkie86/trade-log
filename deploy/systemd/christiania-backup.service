[Unit]
Description=Christiania Verified SQLite Backup
After=network-online.target

[Service]
Type=oneshot
User=christiania
Group=christiania
WorkingDirectory=/opt/christiania
EnvironmentFile=/etc/christiania/christiania.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/christiania/.venv/bin/python /opt/christiania/backup_christiania.py
ExecStopPost=/bin/sh -c 'dir="${CHRISTIANIA_BACKUP_DIR:-/var/lib/christiania/backups}"; find "$dir" -maxdepth 1 -type f \( -name ".christiania_backup_*.tmp.db" -o -name ".christiania_backup_*.tmp.db-journal" -o -name ".christiania_backup_*.tmp.db-wal" -o -name ".christiania_backup_*.tmp.db-shm" \) -delete'
NoNewPrivileges=true
PrivateTmp=true
