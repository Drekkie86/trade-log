#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/run/christiania"
STATE_FILE="${STATE_DIR}/maintenance.state"
SECURE_EDGE_SERVICE="christiania-oauth2-proxy.service"

QUIESCE_TIMER_UNITS=(
  "christiania-audit.timer"
  "christiania-backup.timer"
  "christiania-backup-compress.timer"
  "christiania-burn-in.timer"
  "christiania-health.timer"
  "christiania-restore-drill.timer"
  "christiania-supervisor.timer"
  "christiania-theta-refresh.timer"
  "christiania-theta-watchdog.timer"
  "christiania-v1-readiness.timer"
)

QUIESCE_ONESHOT_SERVICES=(
  "christiania-audit.service"
  "christiania-backup.service"
  "christiania-backup-compress.service"
  "christiania-burn-in.service"
  "christiania-health.service"
  "christiania-restore-drill.service"
  "christiania-supervisor.service"
  "christiania-theta-refresh.service"
  "christiania-theta-watchdog.service"
  "christiania-theta-recover.service"
  "christiania-v1-readiness.service"
)

DB_CONSUMER_SERVICES=(
  "christiania-daemon.service"
  "christiania-app.service"
)

fail() {
  echo "CHRISTIANIA MAINTENANCE ERROR: $*" >&2
  return 1
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    fail "run as root"
  fi
}

unit_is_active() {
  systemctl is-active --quiet "$1"
}

unit_state() {
  local unit="$1"
  local load_state
  local active_state
  local sub_state
  local enabled_state

  load_state="$(
    systemctl show \
      --property=LoadState \
      --value \
      "${unit}" \
      2>/dev/null \
      || true
  )"

  active_state="$(
    systemctl is-active \
      "${unit}" \
      2>/dev/null \
      || true
  )"

  sub_state="$(
    systemctl show \
      --property=SubState \
      --value \
      "${unit}" \
      2>/dev/null \
      || true
  )"

  enabled_state="$(
    systemctl is-enabled \
      "${unit}" \
      2>/dev/null \
      || true
  )"

  printf '%s|%s|%s|%s\n' \
    "${load_state:-unknown}" \
    "${active_state:-unknown}" \
    "${sub_state:-unknown}" \
    "${enabled_state:-unknown}"
}

stop_optional_unit() {
  local unit="$1"
  local load_state

  load_state="$(
    systemctl show       --property=LoadState       --value       "${unit}"       2>/dev/null       || true
  )"

  if [[ -z "${load_state}" || "${load_state}" == "not-found" ]]; then
    echo "Skipping optional unit ${unit}; not installed."
    return 0
  fi

  systemctl stop "${unit}"

  if unit_is_active "${unit}"; then
    fail "${unit} remained active after maintenance quiescence"
  fi
}

record_state() {
  local temp
  temp="$(mktemp "${STATE_DIR}/maintenance.state.XXXXXX")"
  chmod 0600 "${temp}"

  {
    printf 'ENTERED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    for unit in "${DB_CONSUMER_SERVICES[@]}" "${SECURE_EDGE_SERVICE}"; do
      if unit_is_active "${unit}"; then
        printf 'SERVICE=%s\n' "${unit}"
      fi
    done

    for unit in "${QUIESCE_TIMER_UNITS[@]}"; do
      if unit_is_active "${unit}"; then
        printf 'TIMER=%s\n' "${unit}"
      fi
    done
  } > "${temp}"

  # Promote without overwrite. Hard-link creation is atomic on the same
  # runtime filesystem, so concurrent maintenance entrants cannot both own
  # the state. The pre-check above is only for a clearer operator message.
  if ! ln "${temp}" "${STATE_FILE}" 2>/dev/null; then
    rm -f "${temp}"
    fail "maintenance state was claimed concurrently at ${STATE_FILE}"
  fi

  rm -f "${temp}"
}

state_contains() {
  local kind="$1"
  local unit="$2"

  grep -Fxq "${kind}=${unit}" "${STATE_FILE}"
}

restore_recorded() {
  local failed=0

  # The OAuth proxy Requires=christiania-app.service. Restore the database
  # consumers first, then the public edge, then scheduled work.
  for unit in "${DB_CONSUMER_SERVICES[@]}"; do
    if state_contains SERVICE "${unit}"; then
      echo "Restoring ${unit}..."
      systemctl start "${unit}" || failed=1
    fi
  done

  if state_contains SERVICE "${SECURE_EDGE_SERVICE}"; then
    echo "Restoring ${SECURE_EDGE_SERVICE}..."
    systemctl start "${SECURE_EDGE_SERVICE}" || failed=1
  fi

  while IFS='=' read -r kind unit; do
    if [[ "${kind}" != "TIMER" || -z "${unit}" ]]; then
      continue
    fi

    echo "Restoring ${unit}..."
    systemctl start "${unit}" || failed=1
  done < "${STATE_FILE}"

  while IFS='=' read -r kind unit; do
    case "${kind}" in
      SERVICE|TIMER)
        if ! unit_is_active "${unit}"; then
          echo "Restore verification failed: ${unit} is not active." >&2
          failed=1
        fi
        ;;
    esac
  done < "${STATE_FILE}"

  return "${failed}"
}

enter_maintenance() {
  require_root

  install -d -m 0755 -o root -g root "${STATE_DIR}"

  if [[ -e "${STATE_FILE}" ]]; then
    fail "maintenance state already exists at ${STATE_FILE}; inspect or exit the existing maintenance window"
  fi

  record_state

  restore_on_failure() {
    local rc=$?
    trap - ERR INT TERM HUP

    echo "Maintenance entry failed; restoring the recorded runtime." >&2

    if restore_recorded; then
      rm -f "${STATE_FILE}"
    else
      echo "Runtime restore was incomplete; state retained at ${STATE_FILE}." >&2
    fi

    exit "${rc}"
  }

  trap restore_on_failure ERR INT TERM HUP

  echo "Stopping scheduled Christiania work..."
  for unit in "${QUIESCE_TIMER_UNITS[@]}"; do
    stop_optional_unit "${unit}"
  done

  for unit in "${QUIESCE_ONESHOT_SERVICES[@]}"; do
    if unit_is_active "${unit}"; then
      fail "one-shot maintenance service is already active; refusing to interrupt it: ${unit}"
    fi
  done

  # Stop the edge explicitly before the app. Stopping the app also propagates
  # to the proxy through Requires=, but explicit ordering keeps the maintenance
  # contract deterministic and makes restoration intent visible.
  stop_optional_unit "${SECURE_EDGE_SERVICE}"

  echo "Stopping database consumers..."
  for unit in "${DB_CONSUMER_SERVICES[@]}"; do
    systemctl stop "${unit}"
  done

  for unit in "${DB_CONSUMER_SERVICES[@]}"; do
    if unit_is_active "${unit}"; then
      fail "${unit} remained active after quiescence"
    fi
  done

  if ! unit_is_active christiania-theta.service; then
    fail "christiania-theta.service must remain active during database maintenance"
  fi

  # Check one-shot work again at the final boundary. This catches a service
  # manually started after scheduling timers were stopped but before the
  # maintenance window would otherwise be declared open.
  for unit in "${QUIESCE_ONESHOT_SERVICES[@]}"; do
    if unit_is_active "${unit}"; then
      fail "one-shot maintenance service became active while entering maintenance: ${unit}"
    fi
  done

  trap - ERR INT TERM HUP

  echo "CHRISTIANIA_MAINTENANCE_ENTERED"
  echo "state_file=${STATE_FILE}"
}

exit_maintenance() {
  require_root

  if [[ ! -f "${STATE_FILE}" ]]; then
    fail "no active maintenance state exists at ${STATE_FILE}"
  fi

  if ! restore_recorded; then
    fail "runtime restore incomplete; maintenance state retained at ${STATE_FILE}"
  fi

  rm -f "${STATE_FILE}"

  echo "CHRISTIANIA_MAINTENANCE_EXITED"

  if command -v christiania-status >/dev/null 2>&1; then
    christiania-status || true
  fi
}

rehearse_maintenance() {
  require_root

  if [[ -e "${STATE_FILE}" ]]; then
    fail "cannot rehearse while maintenance state already exists"
  fi

  local before
  local after

  before="$(mktemp)"
  after="$(mktemp)"

  cleanup_rehearsal_files() {
    rm -f "${before}" "${after}"
  }

  # The enter path owns ERR/INT/TERM/HUP while it transitions runtime state.
  # Keep a separate EXIT cleanup active before calling it so rehearsal
  # scratch files cannot leak if entry itself exits early.
  trap cleanup_rehearsal_files EXIT

  snapshot_rehearsal_state() {
    local output="$1"

    : > "${output}"

    for unit in       christiania-theta.service       "${DB_CONSUMER_SERVICES[@]}"       "${SECURE_EDGE_SERVICE}"       caddy.service       "${QUIESCE_TIMER_UNITS[@]}"; do
      printf '%s=%s\n'         "${unit}"         "$(unit_state "${unit}")"         >> "${output}"
    done
  }

  snapshot_rehearsal_state "${before}"

  echo "=== MAINTENANCE REHEARSAL: ENTER ==="
  enter_maintenance

  rehearsal_restore_on_failure() {
    local rc=$?
    trap - ERR INT TERM HUP

    echo "Maintenance rehearsal failed; restoring runtime." >&2

    if [[ -f "${STATE_FILE}" ]]; then
      exit_maintenance || true
    fi

    cleanup_rehearsal_files
    exit "${rc}"
  }

  trap rehearsal_restore_on_failure ERR INT TERM HUP

  if [[ ! -f "${STATE_FILE}" ]]; then
    fail "maintenance state file missing during rehearsal"
  fi

  if ! unit_is_active christiania-theta.service; then
    fail "Theta is not active during rehearsal maintenance window"
  fi

  for unit in "${DB_CONSUMER_SERVICES[@]}" "${SECURE_EDGE_SERVICE}"; do
    if unit_is_active "${unit}"; then
      fail "${unit} remained active during rehearsal maintenance window"
    fi
  done

  for unit in "${QUIESCE_TIMER_UNITS[@]}"; do
    if unit_is_active "${unit}"; then
      fail "${unit} remained active during rehearsal maintenance window"
    fi
  done

  for unit in "${QUIESCE_ONESHOT_SERVICES[@]}"; do
    if unit_is_active "${unit}"; then
      fail "${unit} became active during rehearsal maintenance window"
    fi
  done

  echo "=== MAINTENANCE REHEARSAL: EXIT ==="
  exit_maintenance

  snapshot_rehearsal_state "${after}"

  if ! diff -u "${before}" "${after}"; then
    fail "runtime state did not restore exactly after maintenance rehearsal"
  fi

  trap - ERR INT TERM HUP
  cleanup_rehearsal_files
  trap - EXIT

  echo "MAINTENANCE_REHEARSAL_PASS"
}

show_status() {
  require_root

  if [[ -f "${STATE_FILE}" ]]; then
    echo "maintenance=ACTIVE"
    cat "${STATE_FILE}"
  else
    echo "maintenance=INACTIVE"
  fi

  echo
  for unit in     christiania-theta.service     christiania-daemon.service     christiania-app.service     "${SECURE_EDGE_SERVICE}"     caddy.service; do
    printf '%-38s %s\n'       "${unit}"       "$(systemctl is-active "${unit}" 2>/dev/null || true)"
  done
}

case "${1:-}" in
  enter)
    enter_maintenance
    ;;
  exit)
    exit_maintenance
    ;;
  status)
    show_status
    ;;
  rehearse)
    rehearse_maintenance
    ;;
  *)
    echo "Usage: sudo /opt/christiania/deploy/christiania-maintenance {enter|exit|status|rehearse}" >&2
    exit 2
    ;;
esac
