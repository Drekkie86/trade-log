# Christiania runtime configuration.
# Secrets belong in the real .env or host environment, never in Git.

# Optional: override the default repository-local trade_log.db.
# CHRISTIANIA_DB_PATH=/opt/christiania/data/trade_log.db

# Optional: verified online backup destination.
# CHRISTIANIA_BACKUP_DIR=/opt/christiania/backups

# Optional: number of verified backups retained.
CHRISTIANIA_BACKUP_RETENTION=14

# Optional: operational audit export destination.
# CHRISTIANIA_AUDIT_DIR=/opt/christiania/audit

# Optional/required for one-VM service deployment.
# CHRISTIANIA_THETA_JAR=/opt/christiania/vendor/ThetaTerminalv3.jar
# THETADATA_API_KEY=populate-in-real-env-only
# CHRISTIANIA_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,JPM,XOM,SPY,QQQ,IWM,TSLA,GOOGL,AMD,BAC,COST,AVGO,MU,PLTR,NFLX,COIN,GLD,SMH,XLF,XLE,TLT,IBIT
CHRISTIANIA_THETA_BASE_URL=http://127.0.0.1:25503/v3
# Secure browser edge (Package 6).
# Public DNS must point to the VM before Caddy can obtain a public certificate.
CHRISTIANIA_PUBLIC_HOST=christiania.example.com
OAUTH2_PROXY_REDIRECT_URL=https://christiania.example.com/oauth2/callback
OAUTH2_PROXY_OIDC_ISSUER_URL=https://identity.example.com/
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/christiania/authorized_emails.txt
